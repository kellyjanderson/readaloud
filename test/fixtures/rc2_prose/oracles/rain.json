{
  "audit": "https://github.com/kellyjanderson/readaloud/issues/89#issuecomment-6429213427",
  "sourceSha256": "e1c0aa68f4475608ebf62881c2115f2e1872bedf4595edffd18d5fc71d8971eb",
  "canonicalCastIds": [
    "cast_character_beatrice",
