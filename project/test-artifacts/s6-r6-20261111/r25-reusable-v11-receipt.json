      "durationMs": 22341,
      "sceneTurns": [
        {
          "voice": "library_fishadrian",
          "text": "At dawn the eastern clouds became pink and the fields emerged from the silver mist. The first light touched the roofs and windows of the houses along the winding road.",
          "segmentIds": [
            "r0_s_11",
            "r0_s_12"
          ],
          "startWord": 137,
